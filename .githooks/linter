#!/usr/bin/env bash

set -euo pipefail

echo ""

if [ -t 1 ]; then
  GREEN=$'\033[0;32m'
  YELLOW=$'\033[0;33m'
  RED=$'\033[0;31m'
  NC=$'\033[0m'
else
  GREEN=""; YELLOW=""; RED=""; NC=""
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$SCRIPT_DIR/.."

cd "$WORKSPACE_ROOT" || {
  echo "${RED}Unable to change to workspace root: $WORKSPACE_ROOT${NC}"
  exit 1
}

# git feeds the refs being pushed on stdin, one line per ref. Read them once:
# they say both whether there is anything to lint and which files changed.
REFS=""
if [ ! -t 0 ]; then
  REFS="$(cat)"
fi

if [ -n "$REFS" ] && ! printf '%s\n' "$REFS" | awk '{print $2}' | grep -qE '[^0]'; then
  echo "${GREEN}Only branch deletions pushed, nothing to lint${NC}"
  echo ""
  exit 0
fi

echo "${YELLOW}Linting before pushing${NC}"
echo "${YELLOW}(skip with 'git push --no-verify')${NC}"

# modules/sacess, deps and the CUQDyn* trees are vendored: sacess comes from
# upstream and the CUQDyn folders are the reference Matlab toolbox. Linting them
# would report on code this project does not own. Same list as the formatter.
VENDORED='^(modules/sacess|deps|CUQDyn|CUQDyn1_Plus)/'

# Every tracked file matching $1, minus the vendored trees.
owned() {
  git ls-files \
    | { grep -vE "$VENDORED" || true; } \
    | { grep -E "$1" || true; }
}

RUN=()
if command -v cargo >/dev/null 2>&1 && command -v clang-tidy >/dev/null 2>&1; then
  RUN=(bash -lc)
elif command -v docker >/dev/null 2>&1 &&
     docker compose ps --status running --services 2>/dev/null | grep -qx cuqdyn_c; then
  RUN=(docker compose exec -T cuqdyn_c bash -lc)
elif command -v cargo >/dev/null 2>&1; then
  RUN=(bash -lc)
else
  # Consistent with the formatter: a gap in someone's setup warns rather than
  # refusing their push.
  echo "${YELLOW}   WARNING: no linter toolchain and no cuqdyn_c container found.${NC}"
  echo "${YELLOW}   Skipping. Start the container with 'docker compose up -d'.${NC}"
  echo ""
  exit 0
fi

SKIPPED=0

# --- clippy ------------------------------------------------------------------
CLIPPY_LOG=/tmp/cuqdyn-prepush-clippy.log
echo ""
echo "${YELLOW}==> clippy${NC}"
if "${RUN[@]}" "command -v cargo" >/dev/null 2>&1; then
  if ! "${RUN[@]}" "cd modules/cuqdyn-rs && cargo clippy --all-targets -- -D warnings" \
       > "$CLIPPY_LOG" 2>&1; then
    echo "${RED}ERROR: clippy reported problems. Last lines:${NC}"
    tail -25 "$CLIPPY_LOG"
    echo ""
    echo "${RED}Push aborted. Full log: $CLIPPY_LOG${NC}"
    exit 1
  fi
else
  echo "${YELLOW}   WARNING: cargo not found, skipping.${NC}"
  SKIPPED=$((SKIPPED + 1))
fi

# --- clang-tidy --------------------------------------------------------------
# The whole of the project's own C
echo "${YELLOW}==> clang-tidy${NC}"

BUILD_DIR=""
for candidate in build-serial build-mpi build-debug; do
  if [ -f "$candidate/compile_commands.json" ]; then
    BUILD_DIR="$candidate"
    break
  fi
done

mapfile -t TIDY_FILES < <(owned '\.c$')

if ! "${RUN[@]}" "command -v clang-tidy" >/dev/null 2>&1; then
  echo "${YELLOW}   WARNING: clang-tidy not found, skipping.${NC}"
  SKIPPED=$((SKIPPED + 1))
elif [ -z "$BUILD_DIR" ]; then
  echo "${YELLOW}   WARNING: no compile_commands.json found, skipping.${NC}"
  echo "${YELLOW}   Build once with './scripts/build.sh serial' to enable this check.${NC}"
  SKIPPED=$((SKIPPED + 1))
elif [ ${#TIDY_FILES[@]} -eq 0 ]; then
  echo "${YELLOW}   WARNING: no C sources found, skipping.${NC}"
  SKIPPED=$((SKIPPED + 1))
else
  echo "   ${#TIDY_FILES[@]} file(s), against $BUILD_DIR"
  TIDY_LOG=/tmp/cuqdyn-prepush-tidy.log
  if ! "${RUN[@]}" "clang-tidy -p $BUILD_DIR --quiet ${TIDY_FILES[*]}" > "$TIDY_LOG" 2>&1; then
    echo "${RED}ERROR: clang-tidy reported problems:${NC}"
    grep -E "(warning|error):" "$TIDY_LOG" | head -15 || tail -20 "$TIDY_LOG"
    echo ""
    echo "${RED}Push aborted. Full log: $TIDY_LOG${NC}"
    exit 1
  fi
fi

echo ""
if [ "$SKIPPED" -gt 0 ]; then
  echo "${YELLOW}Linting passed, $SKIPPED check(s) skipped for missing tools${NC}"
else
  echo "${GREEN}Linting passed${NC}"
fi
echo ""
exit 0
