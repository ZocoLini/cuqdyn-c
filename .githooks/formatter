#!/usr/bin/env bash
set -euo pipefail

echo ""

if [ -t 1 ]; then
  GREEN=$'\033[0;32m'
  YELLOW=$'\033[0;33m'
  RED=$'\033[0;31m'
  NC=$'\033[0m'
else
  GREEN=""; YELLOW=""; RED=""; NC=""
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$SCRIPT_DIR/.."

cd "$WORKSPACE_ROOT" || {
  echo "${RED}Unable to change to workspace root: $WORKSPACE_ROOT${NC}"
  exit 1
}

echo "${YELLOW}Running formatter over the whole tree${NC}"

# modules/sacess, deps and the CUQDyn* trees are vendored: sacess comes from
# upstream and the CUQDyn folders are the reference Matlab toolbox. Reformatting
# them would bury real changes under thousands of noise lines.
VENDORED='^(modules/sacess|deps|CUQDyn|CUQDyn1_Plus)/'

# The project container already carries every formatter (see Dockerfile), and
# docker-compose mounts the repository at its working directory, so the same
# repo-relative paths work inside and outside.
CONTAINER=""
if command -v docker >/dev/null 2>&1 &&
   docker compose ps --status running --services 2>/dev/null | grep -qx cuqdyn_c; then
  CONTAINER="cuqdyn_c"
fi

# Every tracked file matching $1, minus the vendored trees. Checking the whole
# tree rather than just what is staged means formatting cannot drift: a file
# someone committed with --no-verify is caught by the next commit, whoever makes
# it. Never fails: an empty result is normal for languages the repo barely uses.
owned() {
  git ls-files \
    | { grep -vE "$VENDORED" || true; } \
    | { grep -E "$1" || true; }
}

have() { command -v "$1" >/dev/null 2>&1; }

# Picks how to invoke a formatter and leaves it in RUNNER. Local install wins;
# the container is the fallback. A tool available in neither only warns: a gap
# in someone's setup is not a reason to refuse their commit.
# Set RUNNER_ENV to a list of VAR=value before calling resolve when the tool
# needs environment; it has to be forwarded with -e to reach inside a container.
RUNNER=()
RUNNER_ENV=()
resolve() {
  local tool=$1 hint=$2
  local status=1
  if have "$tool"; then
    if [ ${#RUNNER_ENV[@]} -gt 0 ]; then
      RUNNER=(env "${RUNNER_ENV[@]}" "$tool")
    else
      RUNNER=("$tool")
    fi
    status=0
  elif [ -n "$CONTAINER" ] &&
       docker compose exec -T "$CONTAINER" sh -lc "command -v $tool" >/dev/null 2>&1; then
    local env_flags=()
    local kv
    for kv in ${RUNNER_ENV[@]+"${RUNNER_ENV[@]}"}; do
      env_flags+=(-e "$kv")
    done
    RUNNER=(docker compose exec -T ${env_flags[@]+"${env_flags[@]}"} "$CONTAINER" "$tool")
    echo "   ${tool} not installed locally, running it in the ${CONTAINER} container"
    status=0
  fi
  RUNNER_ENV=()
  if [ $status -eq 0 ]; then
    return 0
  fi
  echo "${YELLOW}   WARNING: $tool not found, skipping this check. $hint${NC}"
  SKIPPED=$((SKIPPED + 1))
  return 1
}

SKIPPED=0

# Reports the reformat and stops the commit, so the author reviews what changed
# instead of committing a diff they never saw.
reformatted() {
  echo ""
  echo "${YELLOW}Files were reformatted. Run 'git add .' and commit again.${NC}"
  exit 1
}

DOCKER_HINT="Install it, or start the project container with 'docker compose up -d'."

# --- C / C++ -----------------------------------------------------------------
# .clang-format at the repository root is the single source of style.
mapfile -t C_FILES < <(owned '\.(c|h|cpp|hpp|cc)$')
if [ ${#C_FILES[@]} -gt 0 ]; then
  echo "${YELLOW}==> clang-format (check)${NC}"
  if resolve clang-format "$DOCKER_HINT"; then
    if ! "${RUNNER[@]}" --dry-run --Werror "${C_FILES[@]}" >/dev/null 2>&1; then
      echo "${RED}ERROR: Formatting issues detected. Applying clang-format...${NC}"
      "${RUNNER[@]}" -i "${C_FILES[@]}"
      reformatted
    fi
  fi
fi

# --- Rust --------------------------------------------------------------------
mapfile -t RS_FILES < <(owned '\.rs$')
if [ ${#RS_FILES[@]} -gt 0 ]; then
  echo "${YELLOW}==> cargo fmt (check)${NC}"
  if resolve cargo "Install the Rust toolchain with rustup."; then
    # cargo fmt works on the crate, not on a file list.
    if ! (cd modules/cuqdyn-rs && "${RUNNER[@]}" fmt --all -- --check >/dev/null 2>&1); then
      echo "${RED}ERROR: Formatting issues detected. Applying cargo fmt...${NC}"
      (cd modules/cuqdyn-rs && "${RUNNER[@]}" fmt --all)
      reformatted
    fi
  fi
fi

# --- Fortran -----------------------------------------------------------------
# Every .f/.f90 in the tree currently belongs to the vendored sacess library, so
# this only starts doing anything if the project grows Fortran of its own.
mapfile -t F_FILES < <(owned '\.([fF]|f90|F90|f77|for)$')
if [ ${#F_FILES[@]} -gt 0 ]; then
  echo "${YELLOW}==> fprettify (check)${NC}"
  if resolve fprettify "$DOCKER_HINT"; then
    if [ -n "$("${RUNNER[@]}" --diff "${F_FILES[@]}" 2>/dev/null)" ]; then
      echo "${RED}ERROR: Formatting issues detected. Applying fprettify...${NC}"
      "${RUNNER[@]}" "${F_FILES[@]}"
      reformatted
    fi
  fi
fi

# --- Markdown ----------------------------------------------------------------
mapfile -t MD_FILES < <(owned '\.md$')
if [ ${#MD_FILES[@]} -gt 0 ]; then
  echo "${YELLOW}==> mdformat (check)${NC}"
  if resolve mdformat "$DOCKER_HINT"; then
    if ! "${RUNNER[@]}" --check "${MD_FILES[@]}" >/dev/null 2>&1; then
      echo "${RED}ERROR: Formatting issues detected. Applying mdformat...${NC}"
      "${RUNNER[@]}" "${MD_FILES[@]}" >/dev/null
      reformatted
    fi
  fi
fi

# --- Python ------------------------------------------------------------------
mapfile -t PY_FILES < <(owned '\.py$')
if [ ${#PY_FILES[@]} -gt 0 ]; then
  echo "${YELLOW}==> black (check)${NC}"
  if resolve black "$DOCKER_HINT"; then
    if ! "${RUNNER[@]}" --check --quiet "${PY_FILES[@]}" >/dev/null 2>&1; then
      echo "${RED}ERROR: Formatting issues detected. Applying black...${NC}"
      "${RUNNER[@]}" --quiet "${PY_FILES[@]}"
      reformatted
    fi
  fi
fi

# --- Shell -------------------------------------------------------------------
mapfile -t SH_FILES < <(owned '\.sh$')
if [ ${#SH_FILES[@]} -gt 0 ]; then
  echo "${YELLOW}==> shfmt (check)${NC}"
  if resolve shfmt "$DOCKER_HINT"; then
    if ! "${RUNNER[@]}" --diff --indent 2 "${SH_FILES[@]}" >/dev/null 2>&1; then
      echo "${RED}ERROR: Formatting issues detected. Applying shfmt...${NC}"
      "${RUNNER[@]}" --write --indent 2 "${SH_FILES[@]}"
      reformatted
    fi
  fi
fi

# --- CMake -------------------------------------------------------------------
mapfile -t CMAKE_FILES < <(owned '(\.cmake|CMakeLists\.txt)$')
if [ ${#CMAKE_FILES[@]} -gt 0 ]; then
  echo "${YELLOW}==> gersemi (check)${NC}"
  if resolve gersemi "$DOCKER_HINT"; then
    if ! "${RUNNER[@]}" --check "${CMAKE_FILES[@]}" >/dev/null 2>&1; then
      echo "${RED}ERROR: Formatting issues detected. Applying gersemi...${NC}"
      "${RUNNER[@]}" --in-place "${CMAKE_FILES[@]}"
      reformatted
    fi
  fi
fi

# --- XML ---------------------------------------------------------------------
# xmllint reindents structure and leaves text nodes alone, which matters here:
# modules/cuqdyn-rs/src/context.rs:463 splits <ode_expr> on newlines, so one
# equation per line is load-bearing and a formatter that reflowed it would fold
# a 15-state model into a single equation.
mapfile -t XML_FILES < <(owned '\.xml$')
if [ ${#XML_FILES[@]} -gt 0 ]; then
  echo "${YELLOW}==> xmllint (check)${NC}"
  RUNNER_ENV=(XMLLINT_INDENT="    ")
  if resolve xmllint "$DOCKER_HINT"; then
    NEEDS_FORMAT=()
    for f in "${XML_FILES[@]}"; do
      if ! "${RUNNER[@]}" --format "$f" 2>/dev/null | diff -q - "$f" >/dev/null 2>&1; then
        NEEDS_FORMAT+=("$f")
      fi
    done
    if [ ${#NEEDS_FORMAT[@]} -gt 0 ]; then
      echo "${RED}ERROR: Formatting issues detected. Applying xmllint...${NC}"
      for f in "${NEEDS_FORMAT[@]}"; do
        "${RUNNER[@]}" --format "$f" > "$f.fmt" && mv "$f.fmt" "$f"
      done
      reformatted
    fi
  fi
fi

echo ""
if [ "$SKIPPED" -gt 0 ]; then
  echo "${YELLOW}Formatting passed, $SKIPPED check(s) skipped for missing tools${NC}"
else
  echo "${GREEN}All formatting checks passed${NC}"
fi
echo ""
exit 0
