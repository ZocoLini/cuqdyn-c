<xml>
    <run>
        <typebench>customized</typebench>
        <id>0</id>
        <log_scale>1</log_scale>
        <output>1</output>
        <verbose>1</verbose>
        <local_search>1</local_search>
        <stopping_criteria>
            <!-- n_params * 2000, as run_AP_CUQDyn1Plus_partobs_example.m uses -->
            <maxevaluation>1e4</maxevaluation>
            <maxtime>1e10</maxtime>
            <vtr>0</vtr>
        </stopping_criteria>
    </run>
    <method name="ScatterSearch">
        <user_options>
            <weight>default</weight>
            <tolc>default</tolc>
            <prob_bound>default</prob_bound>
            <nstuck_solution>default</nstuck_solution>
        </user_options>
        <global_options>
            <dim_ref>default</dim_ref>
            <ndiverse>default</ndiverse>
            <combination>default</combination>
            <n_stuck>default</n_stuck>
        </global_options>
        <local_options>
            <solver>nl2sol.dn2gb</solver>
            <tol>0</tol>
            <evalmax>3e3</evalmax>
            <iterprint>0</iterprint>
            <n1>1</n1>
            <n2>10</n2>
            <balance>0.25</balance>
            <bestx>default</bestx>
        </local_options>
    </method>
    <parallelization name="cooperative">
        <!-- saCeSS options -->
        <reception_threshold>1</reception_threshold>
        <evals_threshold>1000</evals_threshold>
        <mult_num_sendSol>10</mult_num_sendSol>
        <minimum_num_sendSol>20</minimum_num_sendSol>
        <!-- CeSS option: migration time -->
        <migration_max_time>10</migration_max_time>
    </parallelization>

    <problem>
        <dim> 5 </dim>
        <neq> 0 </neq>
        <ineq> 0 </ineq>
        <int_var> 0 </int_var>
        <bin_var> 0 </bin_var>
        <!-- true_parameters * 0.05 / * 5.0, point = 0.8 * true, matching the
             MATLAB runner (true = 5.93e-5, 2.96e-5, 2.05e-5, 2.75e-4, 4.0e-5) -->
        <lb>
            2.965e-06, 1.48e-06, 1.025e-06, 1.375e-05, 2.0e-06
        </lb>
        <ub>
            2.965e-04, 1.48e-04, 1.025e-04, 1.375e-03, 2.0e-04
        </ub>
        <point>
            4.744e-05, 2.368e-05, 1.64e-05, 2.2e-04, 3.2e-05
        </point>
    </problem>

</xml>
