# MATLAB run byproducts: the plain-text exports are the reference,
# the .mat workspaces are regenerable.
**/matlab_run/
ess_report.mat
__pycache__/
*.log

# Raw evaluation traces hybrid_meigo_cvodes.m writes next to itself. Tens of MB
# each; hybrid_report_<model>.txt carries the summary that is worth keeping.
layer5/hybrid/log_A_*.txt
layer5/hybrid/log_B_*.txt

# Layer-5 campaign outputs and figures are not versioned: every seed is a full
# stochastic run, and the reports are regenerated from them. They live on the
# machines that produced them (drago: ~/cuqdyn-c-old-data).
layer6/matlab/
layer6/c/
layer6/report_*.md
layer6/*.png
layer6/*.fig
layer6/c_*_results.txt

# Layer-5 runs: both sides' outputs and the evaluation traces, regenerated per run.
layer5/c/
layer5/matlab/*/
layer5/report_*.md
