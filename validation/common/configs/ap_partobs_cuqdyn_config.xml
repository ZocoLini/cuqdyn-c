<?xml version="1.0" encoding="UTF-8" ?>

<!-- Alpha-pinene with partial observability: states y1-y4 are measured at
     every time point and y5 is never measured. Mirrors the MATLAB example
     EXAMPLES/AP/run_AP_CUQDyn1Plus_partobs_example.m (alp, tolerances and
     the unweighted cost). The fully-observed original-method example keeps
     living in alpha_pinene_*. -->
<cuqdyn-config>
    <tolerances>
        <rtol>1e-6</rtol>
        <atol>1e-8, 1e-8, 1e-8, 1e-8, 1e-8</atol>
    </tolerances>
    <ode_expr y_count="5" p_count="5">
        alpha-pinene
    </ode_expr>
    <alp>0.05</alp> <!-- 90% two-sided bands, as in the MATLAB runner -->
</cuqdyn-config>
