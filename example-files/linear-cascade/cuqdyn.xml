<?xml version="1.0" encoding="UTF-8"?>
<!-- Two-state irreversible linear cascade with partial observability:
     only the downstream state (y1) is measured, y0 stays hidden.
     The analytic solution makes this the cheapest end-to-end check. -->
<cuqdyn-config>
    <tolerances>
        <rtol>1e-9</rtol>
        <atol>1e-11, 1e-11</atol>
    </tolerances>
    <ode_expr y_count="2" p_count="2">
        0 - p0 * y0
        p0 * y0 - p1 * y1
    </ode_expr>
    <y0>
        10, 0
    </y0>
    <alp>0.025</alp>
    <cost>
        <residual_model>known_sigma</residual_model>
        <sigma>0.1759373985003693</sigma>
        <sigma_is_known>true</sigma_is_known>
    </cost>
</cuqdyn-config>
