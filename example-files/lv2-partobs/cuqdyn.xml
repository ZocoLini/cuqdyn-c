<?xml version="1.0" encoding="UTF-8"?>
<!-- Lotka-Volterra with partial observability: the prey (y0) is measured at
     every time point and the predator (y1) is never measured. The prey gets
     conformal bands and the predator delta-method ones. -->
<cuqdyn-config>
    <tolerances>
        <rtol>1e-6</rtol>
        <atol>1e-8, 1e-8</atol>
    </tolerances>
    <ode_expr y_count="2" p_count="4">
        (p0 - p1 * y1) * y0
        (p2 * y0 - p3) * y1
    </ode_expr>
    <alp>0.025</alp>
    <!-- 95% two-sided bands -->
    <cost>
        <!-- Synthetic data with 10% noise; sigma is the known measurement scale. -->
        <residual_model>known_sigma</residual_model>
        <sigma>2.4531439541663325</sigma>
        <sigma_is_known>true</sigma_is_known>
    </cost>
</cuqdyn-config>
