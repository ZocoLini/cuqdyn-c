<?xml version="1.0" encoding="UTF-8"?>
<!-- Alpha-pinene with partial observability: states y0-y3 are measured at
     every time point and y4 is never measured. Mirrors the MATLAB example
     EXAMPLES/AP/run_AP_CUQDyn1Plus_partobs_example.m (alp, tolerances and
     the unweighted cost). The fully observed example of the original
     CUQDyn is example-files/alpha-pinene/. -->
<cuqdyn-config>
    <tolerances>
        <rtol>1e-6</rtol>
        <atol>1e-8, 1e-8, 1e-8, 1e-8, 1e-8</atol>
    </tolerances>
    <ode_expr y_count="5" p_count="5">
        alpha-pinene
    </ode_expr>
    <alp>0.05</alp>
    <!-- 90% two-sided bands, as in the MATLAB runner -->
</cuqdyn-config>
