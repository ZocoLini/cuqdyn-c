<?xml version="1.0" encoding="UTF-8"?>
<cuqdyn-config>
    <tolerances>
        <rtol>1e-8</rtol>
        <atol>1e-8</atol>
    </tolerances>
    <ode_expr y_count="1" p_count="2">
        p0 * y0 * (1 - y0 / p1)
    </ode_expr>
    <!-- as CUQDyn/Matlab/Logistic/CUQDyn1.m: alp = 0.05 -->
    <alp>0.05</alp>
</cuqdyn-config>
