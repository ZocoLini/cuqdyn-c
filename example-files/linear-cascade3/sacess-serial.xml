<?xml version="1.0"?>
<xml>
    <run>
        <typebench>customized</typebench>
        <id>0</id>
        <log_scale>1</log_scale>
        <output>1</output>
        <verbose>1</verbose>
        <local_search>1</local_search>
        <stopping_criteria>
            <maxevaluation>1500</maxevaluation>
            <maxtime>1e10</maxtime>
            <vtr>0</vtr>
        </stopping_criteria>
    </run>
    <method name="ScatterSearch">
        <user_options>
            <weight>default</weight>
            <tolc>default</tolc>
            <prob_bound>default</prob_bound>
            <nstuck_solution>default</nstuck_solution>
        </user_options>
        <global_options>
            <dim_ref>default</dim_ref>
            <ndiverse>default</ndiverse>
            <combination>default</combination>
            <n_stuck>default</n_stuck>
        </global_options>
        <local_options>
            <solver>dhc</solver>
            <tol>2</tol>
            <evalmax>3e3</evalmax>
            <iterprint>0</iterprint>
            <n1>1</n1>
            <n2>10</n2>
            <balance>0.25</balance>
            <bestx>default</bestx>
        </local_options>
    </method>
    <parallelization name="cooperative">
        <!-- saCeSS options -->
        <reception_threshold>1</reception_threshold>
        <evals_threshold>1000</evals_threshold>
        <mult_num_sendSol>10</mult_num_sendSol>
        <minimum_num_sendSol>20</minimum_num_sendSol>
        <!-- CeSS option: migration time -->
        <migration_max_time>10</migration_max_time>
    </parallelization>
    <!-- Observing only the terminal state makes the transfer function
         k1*k2/((s+k1)(s+k2)(s+k3)) symmetric under k1<->k2: both orderings fit
         the observed data identically but imply completely different hidden
         dynamics. The bounds below leave both branches reachable on purpose,
         so which one the run lands on depends on the eSS seed. That is the
         point of this example: no amount of data on the terminal state can
         separate them, and the local FIM reports full rank either way because
         the ambiguity is discrete rather than a continuous valley. -->
    <problem>
        <dim> 3 </dim>
        <neq> 0 </neq>
        <ineq> 0 </ineq>
        <int_var> 0 </int_var>
        <bin_var> 0 </bin_var>
        <lb>
            0.0675, 0.024, 0.00825
        </lb>
        <ub>
            1.8000, 0.640, 0.22000
        </ub>
        <point>
            0.3150, 0.200, 0.07700
        </point>
    </problem>
</xml>
