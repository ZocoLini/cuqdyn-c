<?xml version="1.0" encoding="UTF-8" ?>

<!-- Two-state irreversible linear cascade, x2 observed and x1 hidden.
     Mirrors EXAMPLES/LinearCascade/define_problem_LinearCascade.m and the
     integration tolerances recorded in its run_options.mat. -->
<cuqdyn-config>
    <tolerances>
        <rtol>1e-9</rtol>
        <atol>1e-11, 1e-11</atol>
    </tolerances>
    <ode_expr y_count="2" p_count="2">
        0 - p0 * y0
        p0 * y0 - p1 * y1
    </ode_expr>
    <y0>
        10, 0
    </y0>
    <alp>0.025</alp>
    <cost>
        <residual_model>known_sigma</residual_model>
        <sigma>0.1759373985003693</sigma>
        <sigma_is_known>true</sigma_is_known>
    </cost>
</cuqdyn-config>
