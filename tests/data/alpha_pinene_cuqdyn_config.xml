<?xml version="1.0" encoding="UTF-8" ?>

<cuqdyn-config>
    <tolerances>
        <rtol>1e-8</rtol>
        <atol>1e-8, 1e-8, 1e-8, 1e-8, 1e-8</atol>
    </tolerances>
    <ode_expr y_count="5" p_count="5">
        -(p0 + p1) * y0
        p0 * y0
        p1 * y0 - (p2 + p3) * y2 + p4 * y4
        p2 * y2
        p3 * y2 - p4 * y4
    </ode_expr>
</cuqdyn-config>
